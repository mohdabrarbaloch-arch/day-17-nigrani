# ─────────────────────────────────────────────────────────────
# Nigrani — environment configuration
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Application
APP_NAME=Nigrani
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALGORITHM=HS256

# Database
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./nigrani.db
# PostgreSQL (docker-compose):
# DATABASE_URL=postgresql+psycopg://nigrani:nigrani@db:5432/nigrani

# CORS — comma separated origins. Use * only in development.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=120

# Engine tuning
HEALTH_CRITICAL_THRESHOLD=40
HEALTH_WARNING_THRESHOLD=65
RUL_HISTORY_WINDOW=20

# RPA
RPA_AUTO_WORK_ORDERS=true
RPA_ESCALATION_HOURS=24

# Seed admin (created on first boot if no users exist)
SEED_ADMIN_EMAIL=admin@nigrani.dev
SEED_ADMIN_PASSWORD=ChangeMe123!
