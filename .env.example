# ── Nigrani environment ─────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Database. SQLite works with zero setup; Postgres is what you want in prod.
# SQLite:     sqlite:///./nigrani.db
# Postgres:   postgresql+psycopg://nigrani:secret@localhost:5432/nigrani
DATABASE_URL=sqlite:///./nigrani.db

# JWT signing secret. REQUIRED in production — the app refuses to start without it.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime in minutes. 720 = 12 hours.
JWT_TTL_MINUTES=720

# "production" turns on the JWT_SECRET requirement and disables the dev fallback.
ENVIRONMENT=development

# Comma-separated allowed origins, or * for any (development only).
CORS_ORIGINS=*

# Optional: port for uvicorn when running via docker-compose.
PORT=8000
